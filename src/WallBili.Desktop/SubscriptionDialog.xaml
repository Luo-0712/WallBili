<Window x:Class="WallBili.Desktop.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WallBili.Desktop.Presentation"
        Title="选择参与漫游的 UP 主" Width="800" Height="620" MinWidth="660" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}"
        FontFamily="{x:Static ui:UiTypography.Family}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <!-- 与 2_2 设计稿同一套令牌：严格灰阶、直角、细分隔线。 -->
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.PageTitle}" FontSize="23" Text="选择参与漫游的 UP 主" />
            <TextBlock Style="{DynamicResource Text.Muted}" Margin="0,11,0,0"
                       Text="从关注列表中勾选适合连续播放的 UP 主。新关注的 UP 主不会自动加入漫游。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Text.Label}" Text="筛选已加载关注"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="FilterInput" Grid.Column="1" Style="{DynamicResource Input.Field}" Height="37"
                             Tag="按名字筛选，可继续加载更多" TextChanged="Filter_Changed"
                             ToolTip="按名字筛选已加载的关注；可继续加载更多" />
                </Grid>
                <ListBox x:Name="FollowingList" Grid.Row="1" Style="{DynamicResource List.Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="Selection_Click" HorizontalContentAlignment="Stretch" Height="57"
                                      IsHitTestVisible="True">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Creator.Name}" Style="{DynamicResource Text.RowTitle}" />
                                    <TextBlock Text="{Binding Creator.Uid, StringFormat=UID：{0}}"
                                               Style="{DynamicResource Text.Faint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="MoreButton" Grid.Row="2" Style="{DynamicResource Btn.Ghost}" Content="加载更多关注"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="LoadMore_Click" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SelectedTitle" Grid.Row="0" Style="{DynamicResource Text.Section}"
                           Text="已选订阅" Margin="0,0,0,12" />
                <ListBox x:Name="SavedList" Grid.Row="1" Style="{DynamicResource List.Rows}"
                         DisplayMemberPath="Name" />
                <Button Grid.Row="2" Style="{DynamicResource Btn.Ghost}" Content="移除所选订阅"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="Remove_Click" />
            </Grid>
        </Grid>

        <TextBlock x:Name="PageStatus" Grid.Row="2" Style="{DynamicResource Text.Faint}"
                   Text="准备读取关注列表…" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Style="{DynamicResource Text.Faint}" Text="订阅与进度按账号独立保存。" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource Btn.Ghost}" Content="取消" IsCancel="True" Width="84" />
                <Button Style="{DynamicResource Btn.Primary}" Content="保存订阅" IsDefault="True" Width="110"
                        Margin="11,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
