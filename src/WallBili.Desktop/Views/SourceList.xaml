<UserControl x:Class="WallBili.Desktop.Views.SourceList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" xmlns:views="clr-namespace:WallBili.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="来源" FontSize="11" Foreground="#999999" />
            <TextBlock Grid.Column="1" Text="UP 主" FontSize="11" Foreground="#999999" />
            <TextBlock Grid.Column="2" Text="分 P" FontSize="11" Foreground="#999999" />
            <TextBlock Grid.Column="3" Text="操作" FontSize="11" Foreground="#999999" />
            <Border Grid.ColumnSpan="4" Background="#ECECEC" Height="1" VerticalAlignment="Bottom" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SourceRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#ECECEC" BorderThickness="0,0,0,1" Height="74">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:LandscapeArt Width="38" Height="40" Opacity="0.8" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                                        <Button Content="{Binding Title}" ToolTip="{Binding Title}" Command="{Binding DataContext.FilterSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource FlatButton}" Foreground="#191919" HorizontalAlignment="Left" Padding="0" FontSize="13" MinHeight="20" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#999999" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Uploader}" FontSize="12" Foreground="#555555" Margin="0,0,12,0" ToolTip="{Binding Uploader}" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="#555555" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="28" ToolTip="刷新来源" Command="{Binding DataContext.RefreshSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ui:LineIcon Kind="Refresh" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" ToolTip="来源全部加入队列" Command="{Binding DataContext.AddSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ui:LineIcon Kind="Plus" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" ToolTip="移除来源，保留片库与队列" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding ShowRemove, RelativeSource={RelativeSource AncestorType=views:SourceList}, Converter={StaticResource VisibleWhen}}">
                                        <ui:LineIcon Kind="Close" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>