<UserControl x:Class="WallBili.Desktop.Views.QueueView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation">
    <Grid>
        <Grid Visibility="{Binding HasQueue, Converter={StaticResource VisibleWhen}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="70" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ModeId, Mode=OneWay}" SelectionChanged="Mode_Changed" AutomationProperties.Name="队列播放模式" />
                <TextBlock Grid.Column="1" Text="{Binding ModeDescription}" FontSize="11" Foreground="#999999" Margin="24,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="上移" Command="{Binding MoveQueueUpCommand}" MinWidth="76" />
                    <Button Content="下移" Command="{Binding MoveQueueDownCommand}" MinWidth="76" Margin="10,0" />
                    <Button Content="移除" Command="{Binding RemoveQueueCommand}" MinWidth="76" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#F8F8F8" CornerRadius="3" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <ui:LandscapeArt Width="42" Height="40" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlaybackStatus}" FontSize="11" Foreground="#999999" />
                        <TextBlock Text="{Binding CurrentTitle}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#555555" />
                        <TextBlock Text=" / " FontSize="11" Foreground="#999999" />
                        <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#999999" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3">
                <DataGrid x:Name="QueueGrid" ItemsSource="{Binding QueueRows}" SelectedItem="{Binding SelectedQueue}" SelectionMode="Single" MouseDoubleClick="Queue_DoubleClick" AutomationProperties.Name="播放队列条目">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="#F8F8F8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="顺序" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Number}" FontSize="11" Foreground="#999999" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                                        <ui:LineIcon Kind="Sound" Width="16" Height="16" HorizontalAlignment="Left" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标题" Width="4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#191919" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Uploader}" FontSize="11" Foreground="#999999" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="2.4*" />
                        <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="104" />
                        <DataGridTemplateColumn Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Width="28" Command="{Binding DataContext.PlayQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="播放此项">
                                            <ui:LineIcon Kind="Play" Width="14" Height="14" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="28" Command="{Binding DataContext.RemoveQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="从队列移除">
                                            <ui:LineIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="没有匹配的队列条目" Foreground="#808080" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoQueueResults, Converter={StaticResource VisibleWhen}}" />
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="Library" Content="返回片库添加 →" Style="{StaticResource FlatButton}" FontSize="11" />
                <TextBlock Text="移除条目只影响播放队列，片库中的视频会保留。" FontSize="11" Foreground="#999999" />
            </DockPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,55" Visibility="{Binding QueueEmpty, Converter={StaticResource VisibleWhen}}">
            <ui:LineIcon Kind="Queue" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#999999" />
            <TextBlock Text="队列里还没有内容" FontSize="24" HorizontalAlignment="Center" Margin="0,24,0,0" />
            <TextBlock Text="从片库挑选喜欢的视频，安排接下来的音乐。" Foreground="#808080" FontSize="13" Margin="0,12,0,28" />
            <Button Command="{Binding NavigateCommand}" CommandParameter="Library" Content="去片库挑选" Width="140" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>