<UserControl x:Class="WallBili.Desktop.Views.ImportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" Width="640" KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="White" BorderBrush="#DADADA" BorderThickness="1" CornerRadius="6" Padding="32,26,32,30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="添加来源" FontSize="25" FontWeight="Medium" FontFamily="{x:Static ui:UiTypography.StrongFamily}" />
                <TextBlock Text="从喜欢的视频或合集开始。" FontSize="13" Foreground="#808080" Margin="0,10,0,0" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Command="{Binding CloseImportCommand}" ToolTip="关闭" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,-4,-4,0">
                <ui:LineIcon Kind="Close" />
            </Button>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="#ECECEC" BorderThickness="0,0,0,1" />
                <RadioButton Style="{StaticResource TabRadio}" GroupName="ImportMode" IsChecked="{Binding ImportVideo, Mode=OneWay}" Command="{Binding SetImportModeCommand}" CommandParameter="video" Content="视频 / BV" />
                <RadioButton Grid.Column="1" Style="{StaticResource TabRadio}" GroupName="ImportMode" IsChecked="{Binding ImportCollection, Mode=OneWay}" Command="{Binding SetImportModeCommand}" CommandParameter="collection" Content="合集 / 系列" />
                <RadioButton Grid.Column="2" Style="{StaticResource TabRadio}" GroupName="ImportMode" IsChecked="{Binding ImportIds, Mode=OneWay}" Command="{Binding SetImportModeCommand}" CommandParameter="ids" Content="按 ID 导入" />
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,34,0,0" MinHeight="310" IsEnabled="{Binding IsIdle}">
                <StackPanel Visibility="{Binding ImportIds, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                    <TextBlock Text="{Binding ImportLabel}" FontSize="13" Margin="0,0,0,12" />
                    <Grid>
                        <TextBox x:Name="ImportLink" Text="{Binding ImportInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Padding="40,10,12,10" AutomationProperties.Name="来源链接或 BV 号" />
                        <ui:LineIcon Kind="Link" Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="#808080" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding ImportPlaceholder}" FontSize="12" Foreground="#999999" IsHitTestVisible="False" Margin="42,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImportInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="支持 B 站公开视频，以及空间中的合集、系列链接。" FontSize="11" Foreground="#999999" Margin="0,14,0,0" />
                </StackPanel>
                <Grid Visibility="{Binding ImportIds, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="UP 主 UID" FontSize="13" Margin="0,0,0,12" />
                        <TextBox x:Name="ImportUid" Text="{Binding UploaderId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="UP 主 UID" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="合集 / 系列 ID" FontSize="13" Margin="0,0,0,12" />
                        <TextBox Text="{Binding CollectionId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="合集或系列 ID" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="类型" FontSize="13" Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding CollectionKindId}" AutomationProperties.Name="来源类型" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="将自动读取全部分 P" FontSize="15" Margin="0,40,0,12" />
                <TextBlock Text="重复内容会合并到片库，现有队列与进度会保留。" FontSize="13" Foreground="#808080" TextWrapping="Wrap" />
                <TextBlock Text="导入后，可选择需要的条目加入播放队列。" FontSize="13" Foreground="#808080" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ImportError}" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,22,0,0" MinHeight="22" AutomationProperties.Name="导入提示" />
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="#ECECEC" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="ImportSubmit" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Content="{Binding ImportButtonText}" Width="130" IsDefault="{Binding IsImportOpen}" />
                    <Button DockPanel.Dock="Right" Command="{Binding CloseImportCommand}" Content="取消" Width="84" Margin="0,0,12,0" />
                    <TextBlock Text="导入不影响当前播放" FontSize="11" Foreground="#999999" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>