<UserControl x:Class="WallBili.Desktop.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" xmlns:views="clr-namespace:WallBili.Desktop.Views">
    <Grid>
        <Grid Visibility="{Binding HasEntries, Converter={StaticResource VisibleWhen}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#ECECEC" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabRadio}" Padding="0,0,20,14" GroupName="LibraryTabs" IsChecked="{Binding ShowSources, Converter={StaticResource EqualsValue}, ConverterParameter=False, Mode=OneWay}" Checked="Videos_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="全部视频" />
                            <TextBlock Text="{Binding EntryCount}" FontSize="11" Margin="14,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource TabRadio}" Padding="0,0,20,14" GroupName="LibraryTabs" Margin="48,0,0,0" IsChecked="{Binding ShowSources, Mode=OneWay}" Checked="Sources_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="按来源" />
                            <TextBlock Text="{Binding SourceCount}" FontSize="11" Margin="14,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>
                    <Button Content="本地片单" Command="{Binding OpenPlaylistsCommand}"
                            Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,0,0,4" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,22,0,0" Visibility="{Binding ShowSources, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="166" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceFilterCombo" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SourceFilter}" AutomationProperties.Name="来源筛选" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding StatusFilter}" AutomationProperties.Name="状态筛选" />
                    <TextBlock Grid.Column="3" Text="Ctrl / Shift 多选" FontSize="11" Foreground="#999999" HorizontalAlignment="Right" Margin="12,0,24,0" />
                    <Button Grid.Column="4" Command="{Binding AddAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:LineIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="全部加入队列" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="CatalogGrid" RowHeight="56" ItemsSource="{Binding CatalogRows}" MouseDoubleClick="Catalog_DoubleClick" AutomationProperties.Name="视频片库">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="12,6" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="42">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AllVideosSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="全选当前筛选结果" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="选择条目" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="#" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding Number}" FontSize="11" Foreground="#999999" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                                            <ui:LineIcon Kind="Sound" Width="16" Height="16" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="视频 / 分 P" Width="4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#191919" ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#999999" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="UP 主" Binding="{Binding Uploader}" Width="2*" />
                            <DataGridTextColumn Header="分 P" Binding="{Binding Page}" Width="62" />
                            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="88" />
                            <DataGridTemplateColumn Header="状态" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontSize="12" ToolTip="{Binding Failure}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButton}" ToolTip="加入播放队列" Command="{Binding DataContext.AddVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:LineIcon Kind="Plus" Width="16" Height="16" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoFilterResults, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="没有匹配的条目" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="试试其他关键词、来源或状态。" FontSize="13" Foreground="#808080" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="3" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="166" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectionText}" FontSize="12" Foreground="#555555" Margin="16,0,0,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Command="{Binding MoveVideosUpCommand}" FontSize="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:LineIcon Kind="Up" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="上移" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Command="{Binding MoveVideosDownCommand}" FontSize="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:LineIcon Kind="Down" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="下移" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Command="{Binding DeleteVideosCommand}" FontSize="12" Padding="10,4" Content="删除" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="取消选择" Command="{Binding ClearSelectionCommand}" Style="{StaticResource FlatButton}" FontSize="11" Margin="0,0,18,0" />
                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding AddSelectedCommand}" MinHeight="34" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:LineIcon Kind="Plus" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="加入播放队列" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <views:SourceList Grid.Row="1" Margin="0,24,0,0" ShowRemove="True" Visibility="{Binding ShowSources, Converter={StaticResource VisibleWhen}}" />
        </Grid>
        <views:EmptyState Title="片库还是空的" Description="添加一个视频或合集，分 P 会自动整理到这里。" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
    </Grid>
</UserControl>
