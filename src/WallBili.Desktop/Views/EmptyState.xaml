<UserControl x:Class="WallBili.Desktop.Views.EmptyState" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24,0,24,55">
        <ui:LineIcon Kind="Plus" Width="30" Height="30" Foreground="#999999" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="24" HorizontalAlignment="Center" Margin="0,24,0,0" />
        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#808080" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,28" />
        <Button x:Name="EmptyAddSource" Content="添加来源" Width="140" Command="{Binding OpenImportCommand}" />
    </StackPanel>
</UserControl>