<UserControl x:Class="WallBili.Desktop.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" xmlns:views="clr-namespace:WallBili.Desktop.Views">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasEntries, Converter={StaticResource VisibleWhen}}">
            <Grid MinHeight="638">
                <Grid.RowDefinitions>
                    <RowDefinition Height="286" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.8*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="3.3*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="2.45*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前播放" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding PlaybackStatus}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Right" />
                    <StackPanel Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:LandscapeArt Width="88" Height="80" Opacity="0.8" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="22" FontWeight="Medium" ToolTip="{Binding CurrentTitle}" FontFamily="{x:Static ui:UiTypography.StrongFamily}" />
                                <TextBlock Text="{Binding CurrentUploader}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CurrentSource}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="已播放" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="{Binding PositionText}" FontSize="31" />
                            <TextBlock Text="/" Foreground="{StaticResource Faint}" Margin="22,0,10,0" />
                            <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource Faint}" />
                        </StackPanel>
                        <ProgressBar Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding SeekPosition}" Height="2" Margin="0,7,0,20" BorderThickness="0" Foreground="#191919" Background="#ECECEC" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="进度已保存" FontSize="11" Foreground="{StaticResource Faint}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:LineIcon Kind="Headphones" Width="15" Height="15" Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding VolumeText, StringFormat=音量 {0}%}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="接下来播放" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" />
                    <Button Style="{StaticResource FlatButton}" Command="{Binding NavigateCommand}" CommandParameter="Queue" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" FontSize="11">
                        <TextBlock Text="{Binding QueueCount, StringFormat=全部 {0} 项 →}" />
                    </Button>
                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding UpcomingRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PlayQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FlatButton}" Padding="0" HorizontalContentAlignment="Stretch">
                                        <Border BorderBrush="#ECECEC" BorderThickness="0,0,0,1" Padding="0,6,0,12" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="47" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Ink}" ToolTip="{Binding Title}" />
                                                    <TextBlock Text="{Binding Uploader}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="点击条目即可切换播放" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="桌面画面" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsWallpaperEnabled, Mode=OneWay}" Command="{Binding ToggleWallpaperCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="显示桌面画面" />
                    <StackPanel Grid.Row="1">
                        <Viewbox Stretch="Uniform">
                            <ui:LandscapeArt Width="320" Height="180" />
                        </Viewbox>
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FillWindow, Converter={StaticResource EqualsValue}, ConverterParameter=True}" Visibility="Collapsed" />
                            <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="{StaticResource Body}" />
                        </DockPanel>
                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Settings" Content="调整桌面设置 →" FontSize="11" Margin="-6,6,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Grid.ColumnSpan="5" Background="{StaticResource Line}" Margin="0" />
                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="我的来源" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SourcesSummary}" FontSize="11" Foreground="{StaticResource Faint}" Margin="16,0,0,0" />
                    </StackPanel>
                    <Button Content="查看片库 →" Command="{Binding NavigateCommand}" CommandParameter="Library" Style="{StaticResource FlatButton}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" />
                    <views:SourceList Grid.Row="1" />
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,30,0,0">
                    <TextBlock Text="播放选项" Style="{StaticResource SectionTitle}" Margin="0,0,0,28" />
                    <TextBlock Text="播放模式" FontSize="12" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="WorkspaceMode" ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ModeId, Mode=OneWay}" SelectionChanged="Mode_Changed" Margin="0,9,0,24" AutomationProperties.Name="播放模式" />
                    <CheckBox Content="隐藏画面时继续音乐" IsChecked="{Binding ContinueAudio}" FontSize="12" />
                    <TextBlock Text="只听声音，保留当前队列。" FontSize="11" Foreground="{StaticResource Faint}" Margin="24,9,0,24" />
                    <CheckBox Content="登录后在托盘启动" IsChecked="{Binding AutoStart}" FontSize="12" />
                    <TextBlock Text="下次启动恢复上次播放进度。" FontSize="11" Foreground="{StaticResource Faint}" Margin="24,9,0,14" />
                    <Button Content="保存播放选项 →" Command="{Binding ApplySettingsCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" FontSize="11" Margin="-6,0,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <views:EmptyState Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" Title="添加第一个来源" Description="粘贴一个视频或合集链接，开始你的桌面音乐。" />
        <Border VerticalAlignment="Bottom" Background="#F8F8F8" Padding="16" Visibility="{Binding RecoveryPending, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新取流" Command="{Binding RetryCommand}" />
                <StackPanel>
                    <TextBlock Text="网络暂时断开，等待重新连接" FontWeight="Medium" />
                    <TextBlock Text="保留当前项与进度，连接恢复后自动继续。" Style="{StaticResource SecondaryText}" Margin="0,7,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>