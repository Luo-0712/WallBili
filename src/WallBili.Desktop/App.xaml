<Application x:Class="WallBili.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ================================================================
             设计令牌 —— 取自 .codebuddy/figma/2_2 设计稿
             配色为中性灰阶：面板 #F3F3F3~#FCFCFC，文字 #191919/#555555/#808080/#A3A3A3
             圆角统一 4px，边框 #DADADA
             ================================================================ -->

        <!-- 文字 -->
        <SolidColorBrush x:Key="Ink900" Color="#FF191919" />
        <SolidColorBrush x:Key="Ink700" Color="#FF555555" />
        <SolidColorBrush x:Key="Ink500" Color="#FF808080" />
        <SolidColorBrush x:Key="Ink400" Color="#FFA3A3A3" />
        <SolidColorBrush x:Key="OnInk" Color="#FFFFFFFF" />

        <!-- 面 -->
        <SolidColorBrush x:Key="Surface0" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Surface1" Color="#FFFCFCFC" />
        <SolidColorBrush x:Key="Surface2" Color="#FFF8F8F8" />
        <SolidColorBrush x:Key="Surface3" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="Surface4" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="Surface5" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="Surface6" Color="#FFEFEFEF" />
        <SolidColorBrush x:Key="Surface7" Color="#FFECECEC" />
        <SolidColorBrush x:Key="Surface8" Color="#FFE9E9E9" />
        <SolidColorBrush x:Key="Surface9" Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="Surface10" Color="#FFDDDDDD" />

        <!-- 线 -->
        <SolidColorBrush x:Key="Line" Color="#FFDADADA" />
        <SolidColorBrush x:Key="LineSoft" Color="#FFE2E2E2" />
        <SolidColorBrush x:Key="LineMuted" Color="#FFD5D5D5" />
        <SolidColorBrush x:Key="LineStrong" Color="#FFA8A8A8" />
        <SolidColorBrush x:Key="Scrim" Color="#33000000" />

        <!-- 字体：设计字体 → 系统自带首选备选 → 通用兜底（WPF 支持逗号分隔的字体回退链） -->
        <FontFamily x:Key="UiFont">Inter, Geist Sans, Segoe UI Variable Text, Segoe UI, Source Han Sans SC, 思源黑体, Noto Sans SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

        <!-- ============================ 文字样式 ============================ -->
        <Style x:Key="T.Display" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="23" />
        </Style>
        <Style x:Key="T.H1" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="21" />
        </Style>
        <Style x:Key="T.H2" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="T.H3" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="T.H4" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="T.Body" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        </Style>
        <Style x:Key="T.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
        </Style>
        <Style x:Key="T.Small" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink500}" />
        </Style>
        <Style x:Key="T.Tiny" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Ink400}" />
        </Style>
        <Style x:Key="T.Micro" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource Ink500}" />
        </Style>
        <Style x:Key="T.Metric" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
            <Setter Property="FontSize" Value="31" />
        </Style>
        <Style x:Key="T.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink400}" />
        </Style>

        <!-- ============================ 容器样式 ============================ -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface5}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface6}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <!-- ============================ 按钮模板 ============================ -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.66" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Btn.Base" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource BtnTemplate}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Btn.Base}" />

        <!-- 主操作：深色实心 -->
        <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="{StaticResource Ink900}" />
            <Setter Property="Foreground" Value="{StaticResource OnInk}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- 次级操作：描边 -->
        <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}" />

        <!-- 弱化操作：无边框灰底 -->
        <Style x:Key="Btn.Subtle" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        </Style>

        <!-- 纯文字操作 -->
        <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink500}" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- 侧边栏导航项 -->
        <Style x:Key="Btn.Nav" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="37" />
            <Setter Property="Height" Value="37" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============================ 输入控件 ============================ -->
        <Style x:Key="Tb.Base" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Tb.Base}" />
        <Style x:Key="Tb.Search" TargetType="TextBox" BasedOn="{StaticResource Tb.Base}">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource Lst.Row}" />
        </Style>

        <!-- 分页容器：页签标题由左侧导航承担，因此模板只保留选中页内容 -->
        <Style x:Key="Tabs.Plain" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 无边框输入：用于内嵌在卡片里的单行字段 -->
        <Style x:Key="Tb.Flat" TargetType="TextBox" BasedOn="{StaticResource Tb.Base}">
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 侧边栏导航项：选中态由代码切换 Background / FontWeight -->
        <Style x:Key="Btn.NavActive" TargetType="Button" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="Foreground" Value="{StaticResource Ink900}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- 侧边栏分组标题（我的来源） -->
        <Style x:Key="Nav.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Tiny}">
            <Setter Property="Margin" Value="20,0,20,8" />
        </Style>

        <!-- 列表行：来源 / 接下来播放 -->
        <Style x:Key="Lst.Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface4}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface9}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink900}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ 表格样式 ============================ -->
        <Style x:Key="Grid.Header" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Ink500}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Grid.Row" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
        </Style>
        <Style x:Key="Grid.Cell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{StaticResource Surface0}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface0}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Surface6}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource Grid.Header}" />
            <Setter Property="RowStyle" Value="{StaticResource Grid.Row}" />
            <Setter Property="CellStyle" Value="{StaticResource Grid.Cell}" />
        </Style>

    </Application.Resources>
</Application>
