<Application x:Class="WallBili.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallBili.Desktop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ==================================================================
             WallBili 界面主题 —— 规格来自 .codebuddy/figma/2_2 设计稿（V2 浅色极简 · 严格灰阶）。
             所有颜色满足 R = G = B，层级只靠明度、字重、留白与细分隔线表达。
             本字典必须保持扁平：桌面回归测试会把 Application.Resources 的子项整体复制到
             独立窗口里渲染，因此不能使用 MergedDictionaries。
             ================================================================== -->

        <!-- 设计稿的字体栈：拉丁=随应用分发的 Inter，中文=思源黑体 / Noto Sans SC / 雅黑。
             WPF 的字族列表按字回退，一个 FontFamily 就能让中英文各走各的字体；构造细节见 DesignFont。 -->
        <local:DesignFont x:Key="UiFont" />

        <!-- 文字：主要 / 正文 / 辅助 / 次要 -->
        <SolidColorBrush x:Key="Ink900" Color="#FF191919" />
        <SolidColorBrush x:Key="Ink700" Color="#FF555555" />
        <SolidColorBrush x:Key="Ink500" Color="#FF808080" />
        <SolidColorBrush x:Key="Ink400" Color="#FFA3A3A3" />
        <SolidColorBrush x:Key="OnInk" Color="#FFFFFFFF" />

        <!-- 线：分隔线 / 浅边 / 控件边 / 强调边 -->
        <SolidColorBrush x:Key="Line" Color="#FFECECEC" />
        <SolidColorBrush x:Key="LineSoft" Color="#FFE1E1E1" />
        <SolidColorBrush x:Key="LineField" Color="#FFDADADA" />
        <SolidColorBrush x:Key="LineStrong" Color="#FFA8A8A8" />
        <SolidColorBrush x:Key="LineCheck" Color="#FFC8C8C8" />

        <!-- 表面：白 → 轻量 → 选中 → 深色 -->
        <SolidColorBrush x:Key="Surface0" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Surface1" Color="#FFFCFCFC" />
        <SolidColorBrush x:Key="Surface2" Color="#FFF8F8F8" />
        <SolidColorBrush x:Key="Surface3" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="Surface4" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="Surface5" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="Surface6" Color="#FFEFEFEF" />
        <SolidColorBrush x:Key="Surface7" Color="#FFE9E9E9" />
        <SolidColorBrush x:Key="Scrim" Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="SurfaceInk" Color="#FF191919" />
        <SolidColorBrush x:Key="SurfaceInkHover" Color="#FF2E2E2E" />
        <SolidColorBrush x:Key="Track" Color="#FFECECEC" />
        <SolidColorBrush x:Key="ToggleOff" Color="#FFDADADA" />

        <!-- ============================ 文字样式 ============================ -->

        <!-- 20px 以上的文字走 Ideal 排版模式：Display 会把字形吸附到像素网格、把字宽取整，
             小字号清晰但变形，和设计稿（按线性度量渲染）对不上；小字号仍留在 Display。 -->

        <Style x:Key="Text.PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Text.Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Text.Hero" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Text.HeroTime" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Text.StateTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Text.Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Muted" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
        </Style>
        <Style x:Key="Text.Quiet" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
        </Style>
        <Style x:Key="Text.Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
        </Style>
        <Style x:Key="Text.LabelStrong" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
        </Style>
        <Style x:Key="Text.Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
        </Style>
        <Style x:Key="Text.Faint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink400}" />
        </Style>
        <Style x:Key="Text.TableHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink400}" />
        </Style>
        <Style x:Key="Text.RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.RowTitleLarge" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Brand" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
        </Style>
        <Style x:Key="Text.BrandSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
        </Style>

        <!-- ============================ 图标 ============================ -->

        <!-- 图标几何取自设计稿导出，坐标即设计像素：使用处只需给 Data 与颜色 -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="Icon.Thin" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <!-- ============================ 按钮 ============================ -->

        <!-- 主操作：深色实心，直角 -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInk}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceInkHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink400}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级操作：白底细边 -->
        <Style x:Key="Btn.Ghost" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineField}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Ink400}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内图标按钮：平时无痕，悬停浮出一块浅面 -->
        <Style x:Key="Btn.Icon" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 纯文字行动点 -->
        <Style x:Key="Btn.Link" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink500}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏导航项：160×37，选中态为浅面 + 深色粗体（样式名由 RenderNav 按名查找） -->
        <Style x:Key="Btn.Nav" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="37" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn.NavActive" TargetType="Button" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource Surface4}" />
        </Style>

        <!-- 侧栏来源行：整行可点，右侧计数 -->
        <Style x:Key="Btn.Rail" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮 -->
        <Style x:Key="Btn.Window" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn.WindowClose" TargetType="Button" BasedOn="{StaticResource Btn.Window}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ 输入 ============================ -->

        <Style x:Key="Input.Field" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineField}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="41" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ink900}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                           Foreground="{DynamicResource Ink400}" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Ink400}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 弹窗输入：更高，边框更实 -->
        <Style x:Key="Input.Dialog" TargetType="TextBox" BasedOn="{StaticResource Input.Field}">
            <Setter Property="Height" Value="45" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        </Style>

        <!-- 多行输入 -->
        <Style x:Key="Input.Area" TargetType="TextBox" BasedOn="{StaticResource Input.Field}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- 顶栏搜索：无框无底，仅图标与占位文字 -->
        <Style x:Key="Input.Search" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ink900}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}" Foreground="{DynamicResource Ink400}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 无框字段：嵌在卡片里的单行输入（mpv 路径等） -->
        <Style x:Key="Input.Plain" TargetType="TextBox" BasedOn="{StaticResource Input.Field}">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="41" />
        </Style>

        <!-- ============================ 下拉选择 ============================ -->

        <Style x:Key="Select.Item" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink900}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Select.Field" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Ink700}" />
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineField}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="37" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource Select.Item}" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" />
                            <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.ChevronDown}"
                                  Stroke="{DynamicResource Ink500}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
