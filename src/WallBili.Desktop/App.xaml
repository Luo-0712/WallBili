<Application x:Class="WallBili.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                <Setter Property="FontSize" Value="23" />
            </Style>
            <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
            <Style x:Key="Text.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}" />
            <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Style>
            <Style x:Key="Text.Quiet" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}" />
            <Style x:Key="Text.Faint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
            <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource FlatButton}" />
            <Style x:Key="Input.Plain" TargetType="TextBox">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="Input.Area" TargetType="TextBox" BasedOn="{StaticResource Input.Plain}" />
            <Style x:Key="Input.Field" TargetType="TextBox" BasedOn="{StaticResource Input.Plain}" />
            <Style x:Key="List.Rows" TargetType="ListBox">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
