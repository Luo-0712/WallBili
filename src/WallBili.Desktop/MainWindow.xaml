<Window x:Class="WallBili.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WallBili · 桌面音乐播放器" Width="1440" Height="960" MinWidth="1180" MinHeight="820"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <!--
        界面规格来自 .codebuddy/figma/2_2 设计稿：200px 左导航栏 + 顶栏 + 内容区 + 96px 播放条。
        颜色、字号、间距一律取自 App.xaml 的设计令牌，且全部使用 DynamicResource：
        本文件需要能脱离 App.xaml 单独解析（桌面回归测试会这么做）。
        模板里的事件只能用 Click / SelectionChanged / MouseDoubleClick 三种：其余事件在
        构造函数里挂（见 MainWindow 的构造函数注释）。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <!-- ==================================================================
             左导航栏：品牌 → 导航 → 我的来源 → 添加入口 → 账号 → 后台状态 → 托盘
             ================================================================== -->
        <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource Surface0}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <Grid Grid.Row="0" Margin="0,26,0,0" Height="45">
                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Logo}" StrokeThickness="1.67"
                          Stroke="{DynamicResource Ink900}" Width="19" Height="21"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,6,0,0" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="63,0,0,0">
                        <TextBlock Style="{DynamicResource Text.Brand}" Text="WallBili" />
                        <TextBlock Style="{DynamicResource Text.BrandSub}" Text="桌面音乐播放器" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 主导航：Tag 即 ContentTabs 的页索引 -->
                <StackPanel x:Name="NavPanel" Grid.Row="1" Margin="20,49,20,0">
                    <Button x:Name="NavWorkbenchButton" Style="{DynamicResource Btn.Nav}" Tag="0" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavHome}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="播放工作台" Margin="13,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLibraryButton" Style="{DynamicResource Btn.Nav}" Tag="1" Margin="0,10,0,0"
                            Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavLibrary}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="我的片库" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavQueueButton" Style="{DynamicResource Btn.Nav}" Tag="2" Margin="0,10,0,0"
                            Click="Nav_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavQueue}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="播放队列" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="QueueNavCount" Style="{DynamicResource Text.Faint}" Text=""
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 我的来源 -->
                <StackPanel Grid.Row="2" Margin="0,45,0,0">
                    <Grid Height="16" Margin="31,0,33,0">
                        <TextBlock Style="{DynamicResource Text.Faint}" Text="我的来源" VerticalAlignment="Center" />
                        <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.ChevronDown}"
                              Stroke="{DynamicResource Ink500}" Width="6" Height="4"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="RailSources" Style="{DynamicResource List.Rail}" Margin="0,8,0,0" Height="120"
                             SelectionChanged="RailSources_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32">
                                    <Border Width="1" Height="12" Background="{DynamicResource LineSoft}"
                                            HorizontalAlignment="Left" Margin="43,0,0,0" />
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Quiet}"
                                               Foreground="{DynamicResource Ink700}" Margin="58,0,44,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Count}" Style="{DynamicResource Text.Faint}"
                                               HorizontalAlignment="Right" Margin="0,0,28,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 添加入口与设置 -->
                <StackPanel x:Name="NavPanelSecondary" Grid.Row="3" Margin="20,18,20,0">
                    <Button x:Name="NavAddSourceButton" Style="{DynamicResource Btn.Nav}" Tag="5" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavAdd}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" VerticalAlignment="Center" Margin="1,0,0,0" />
                            <TextBlock Text="添加来源" Margin="15,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{DynamicResource Divider}" Margin="11,27,11,26" />
                    <Button x:Name="NavSettingsButton" Style="{DynamicResource Btn.Nav}" Tag="4" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavGear}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="桌面与后台" Margin="13,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 账号 -->
                <Grid Grid.Row="5" Margin="28,0,20,0" Height="34">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.Faint}" Text="当前账号" />
                        <TextBlock x:Name="AccountText" Style="{DynamicResource Text.Quiet}" Text="未登录"
                                   Foreground="{DynamicResource Ink700}" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" Width="112" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button x:Name="LoginButton" Style="{DynamicResource Btn.Ghost}" Content="登录" Height="30"
                            MinWidth="52" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Login_Click" />
                </Grid>

                <!-- 后台播放状态 -->
                <StackPanel Grid.Row="6" Margin="28,0,0,0">
                    <TextBlock Style="{DynamicResource Text.Faint}" Text="后台播放" />
                    <StackPanel Orientation="Horizontal" Margin="1,12,0,0">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Ink500}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackIntentText" Style="{DynamicResource Text.Quiet}"
                                   Foreground="{DynamicResource Ink700}" Text="未在播放" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Text.BrandSub}" Text="关闭窗口将收起到托盘"
                               Foreground="{DynamicResource Ink400}" Margin="0,14,0,0" />
                    <Border Style="{DynamicResource Divider}" Margin="0,18,28,0" />
                    <Button Style="{DynamicResource Btn.Rail}" Click="Hide_Click" Margin="0,15,20,0" Width="152">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavTray}"
                                  Stroke="{DynamicResource Ink700}" Width="13" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="收起到托盘" Style="{DynamicResource Text.Quiet}"
                                       Foreground="{DynamicResource Ink700}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{DynamicResource Text.BrandSub}" Text="WallBili for Windows"
                               Foreground="{DynamicResource Ink400}" Margin="0,24,0,26" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================================
             顶栏与内容区
             ================================================================== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Surface0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Search}"
                      Stroke="{DynamicResource Ink500}" Width="14" Height="14"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{DynamicResource Input.Search}" Width="320"
                         VerticalAlignment="Center" Margin="19,0,0,0" Tag="筛选标题、UP 主或 BV 号" />
                <TextBlock x:Name="StatusText" Grid.Column="3" Style="{DynamicResource Text.Faint}"
                           VerticalAlignment="Center" Margin="0,0,24,0" Text="本地资料已保存"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <Button Grid.Column="4" Style="{DynamicResource Btn.Icon}" Click="Reload_Click" ToolTip="重新加载当前播放地址">
                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Save}"
                          Stroke="{DynamicResource Ink500}" Width="14" Height="14" />
                </Button>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="18,0,10,0" VerticalAlignment="Center">
                    <Button Style="{DynamicResource Btn.Window}" Click="WindowMin_Click" ToolTip="最小化">
                        <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.WindowMin}"
                              Stroke="{DynamicResource Ink700}" Width="10" Height="1" />
                    </Button>
                    <Button Style="{DynamicResource Btn.Window}" Click="WindowMax_Click" ToolTip="最大化 / 还原">
                        <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.WindowMax}"
                              Stroke="{DynamicResource Ink700}" Width="10" Height="10" />
                    </Button>
                    <Button Style="{DynamicResource Btn.WindowClose}" Click="WindowClose_Click" ToolTip="关闭到托盘">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.WindowClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区：左侧导航决定当前页 -->
            <TabControl x:Name="ContentTabs" Grid.Row="1" Style="{DynamicResource Tabs.Plain}"
                        SelectionChanged="Tabs_Changed">

                <!-- ================= 一 · 播放工作台 ================= -->
                <TabItem Style="{DynamicResource Page.Plain}">
                    <Grid Margin="44,36,44,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="421" />
                            <ColumnDefinition Width="49" />
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,31">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="播放工作台" />
                                <TextBlock Style="{DynamicResource Text.PageSubtitle}" Text="视频在后台播放，桌面照常。"
                                           Margin="0,11,0,0" />
                            </StackPanel>
                            <Button Style="{DynamicResource Btn.Primary}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OpenImport_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus11}"
                                          Stroke="{DynamicResource OnInk}" StrokeThickness="1.07"
                                          Width="11" Height="11" VerticalAlignment="Center" />
                                    <TextBlock Text="添加来源" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 当前播放 -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Grid Height="20">
                                <TextBlock Style="{DynamicResource Text.Section}" Text="当前播放" />
                                <TextBlock x:Name="HeroStateText" Style="{DynamicResource Text.Meta}" Text="已停止"
                                           VerticalAlignment="Center" Margin="0,0,30,0" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{DynamicResource Illus.AlbumArt}" Width="94" Height="81" Stretch="Fill" />
                                <StackPanel Grid.Column="1" Margin="19,3,0,0">
                                    <TextBlock x:Name="HeroTitleText" Style="{DynamicResource Text.Hero}" Text="尚未选择播放项"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HeroUploaderText" Style="{DynamicResource Text.Muted}" Text=""
                                               Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HeroPartText" Style="{DynamicResource Text.Faint}" Text=""
                                               Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="已播放" Margin="0,22,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="PositionText" Style="{DynamicResource Text.HeroTime}" Text="00:00" />
                                <TextBlock x:Name="DurationText" Style="{DynamicResource Text.Muted}" Text="/ 00:00"
                                           VerticalAlignment="Bottom" Margin="12,0,0,4" />
                            </StackPanel>
                            <Slider x:Name="Progress" Style="{DynamicResource Slider.Flat}" Maximum="1" Value="0"
                                    Margin="0,12,0,0" />
                            <Grid Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Volume}"
                                          Stroke="{DynamicResource Ink700}" Width="17" Height="12"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeroVolumeText" Style="{DynamicResource Text.Meta}"
                                               Text="音量 0%" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="进度已保存"
                                           HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- 接下来播放 -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <Grid Height="20">
                                <TextBlock Style="{DynamicResource Text.Section}" Text="接下来播放" />
                                <Button Style="{DynamicResource Btn.Link}" Tag="2" Click="Nav_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpcomingAllText" Style="{DynamicResource Text.Faint}"
                                               Text="全部 0 项 →" />
                                </Button>
                            </Grid>
                            <StackPanel Margin="0,24,0,0">
                                <ItemsControl x:Name="UpcomingBox">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="62">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}"
                                                           Style="{DynamicResource Text.Faint}" VerticalAlignment="Top"
                                                           Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.RowTitle}"
                                                               VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding Source}" Style="{DynamicResource Text.Faint}"
                                                               Margin="0,7,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                           Style="{DynamicResource Text.Faint}" VerticalAlignment="Top"
                                                           Margin="0,4,0,0" />
                                                <Border Grid.ColumnSpan="3" Style="{DynamicResource Divider}"
                                                        VerticalAlignment="Bottom" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="双击条目即可切换播放" Margin="0,14,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 桌面画面 -->
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <Grid Height="20">
                                <TextBlock Style="{DynamicResource Text.Section}" Text="桌面画面" />
                                <CheckBox x:Name="WallpaperBox" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" />
                            </Grid>
                            <Image Source="{DynamicResource Illus.DesktopCard}" Width="272" Height="153"
                                   Stretch="Fill" Margin="0,31,0,0" />
                            <Grid Margin="0,19,0,0">
                                <TextBlock x:Name="DesktopMonitorText" Style="{DynamicResource Text.Label}"
                                           Text="显示器 1 · 主屏" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                <TextBlock x:Name="DesktopFitText" Style="{DynamicResource Text.Faint}" Text="填充"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Button Style="{DynamicResource Btn.Link}" Tag="4" Click="Nav_Click"
                                    HorizontalAlignment="Left" Margin="0,17,0,0">
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="调整桌面设置 →" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{DynamicResource Divider}" Margin="0,38,0,0" />

                        <!-- 我的来源 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                            <Grid Height="20" Margin="0,31,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{DynamicResource Text.Section}" Text="我的来源" />
                                    <TextBlock x:Name="LibrarySummaryText" Style="{DynamicResource Text.Faint}"
                                               Text="0 个来源 · 0 个分 P" Margin="13,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{DynamicResource Btn.Link}" Tag="1" Click="Nav_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Text.Faint}" Text="查看片库 →" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,31,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="511" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.TableHeader}" Text="来源" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Text.TableHeader}" Text="UP 主" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{DynamicResource Text.TableHeader}" Text="分 P" />
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource Divider}"
                                        VerticalAlignment="Top" />
                                <ItemsControl x:Name="WorkbenchSourceList" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,1,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="74">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="511" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="39" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="39" Height="42" VerticalAlignment="Center">
                                                        <Image x:Name="ThumbA" Source="{DynamicResource Illus.SourceThumbA}"
                                                               Width="39" Height="42" Stretch="Fill" />
                                                        <Image x:Name="ThumbB" Source="{DynamicResource Illus.SourceThumbB}"
                                                               Width="39" Height="42" Stretch="Fill" Visibility="Collapsed" />
                                                        <Image x:Name="ThumbC" Source="{DynamicResource Illus.SourceThumbC}"
                                                               Width="39" Height="42" Stretch="Fill" Visibility="Collapsed" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.RowTitle}" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource Text.Faint}"
                                                                   Margin="0,7,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Uploader}" Style="{DynamicResource Text.Quiet}"
                                                               Foreground="{DynamicResource Ink700}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2">
                                                    <TextBlock Text="{Binding Count}" Style="{DynamicResource Text.Quiet}"
                                                               Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{DynamicResource Btn.Icon}" Width="24" Height="24"
                                                                Click="RefreshSourceRow_Click" ToolTip="刷新来源">
                                                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Refresh}"
                                                                  Stroke="{DynamicResource Ink500}" Width="11" Height="13" />
                                                        </Button>
                                                        <Button Style="{DynamicResource Btn.Icon}" Width="24" Height="24"
                                                                Click="EnqueueSource_Click" ToolTip="整个来源加入队列">
                                                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus12}"
                                                                  Stroke="{DynamicResource Ink500}" Width="12" Height="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.ColumnSpan="3" Style="{DynamicResource Divider}" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Variant}" Value="1">
                                                    <Setter TargetName="ThumbA" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ThumbB" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Variant}" Value="2">
                                                    <Setter TargetName="ThumbA" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ThumbC" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>

                        <!-- 播放选项 -->
                        <StackPanel Grid.Row="3" Grid.Column="4">
                            <TextBlock Style="{DynamicResource Text.Section}" Text="播放选项" Margin="0,31,0,0" />
                            <TextBlock Style="{DynamicResource Text.Label}" Text="播放模式" Margin="0,29,0,0" />
                            <ComboBox x:Name="ModeBoxHome" Style="{DynamicResource Select.Field}" Margin="0,14,0,0"
                                      SelectionChanged="ModeHome_Changed">
                                <ComboBoxItem Content="列表循环" />
                                <ComboBoxItem Content="顺序播放" />
                            </ComboBox>
                            <Grid Margin="0,28,0,0" Height="20">
                                <CheckBox x:Name="ContinueAudioBox" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Stretch" Content="隐藏画面时继续音乐" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="只听声音，保留当前队列。"
                                       Margin="31,8,0,0" />
                            <Grid Margin="0,27,0,0" Height="20">
                                <CheckBox x:Name="StartupBox" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Stretch" Content="登录后在托盘启动" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="下次启动时恢复播放进度。"
                                       Margin="31,8,0,0" />
                            <Button Style="{DynamicResource Btn.Link}" Tag="4" Click="Nav_Click"
                                    HorizontalAlignment="Left" Margin="0,24,0,0">
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="更多后台设置 →" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ================= 二 · 我的片库 ================= -->
                <TabItem Style="{DynamicResource Page.Plain}">
                    <Grid x:Name="ListsPanel" Margin="44,36,44,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,26">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="我的片库" />
                                <TextBlock x:Name="CatalogSummaryText" Style="{DynamicResource Text.PageSubtitle}"
                                           Text="已导入 0 个分 P，来自 0 个来源。" Margin="0,11,0,0" />
                            </StackPanel>
                            <Button Style="{DynamicResource Btn.Primary}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OpenImport_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus11}"
                                          Stroke="{DynamicResource OnInk}" StrokeThickness="1.07"
                                          Width="11" Height="11" VerticalAlignment="Center" />
                                    <TextBlock Text="添加来源" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 视图页签 -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Height="26">
                                <Button x:Name="CatalogTabAllButton" Style="{DynamicResource Btn.Link}"
                                        Click="CatalogTabAll_Click" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CatalogTabAllText" Style="{DynamicResource Text.RowTitle}"
                                                   FontWeight="Bold" Text="全部视频" />
                                        <TextBlock x:Name="CatalogTabAllCount" Style="{DynamicResource Text.Faint}"
                                                   Text="0" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatalogTabSourceButton" Style="{DynamicResource Btn.Link}"
                                        Click="CatalogTabSource_Click" Margin="49,0,0,0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CatalogTabSourceText" Style="{DynamicResource Text.RowTitle}"
                                                   Foreground="{DynamicResource Ink500}" Text="按来源" />
                                        <TextBlock x:Name="CatalogTabSourceCount" Style="{DynamicResource Text.Faint}"
                                                   Text="0" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Border x:Name="CatalogTabUnderline" Background="{DynamicResource SurfaceInk}"
                                        Height="2" HorizontalAlignment="Left" Width="83" />
                                <Border Style="{DynamicResource Divider}" />
                            </Grid>
                        </Grid>

                        <!-- 筛选与批量操作 -->
                        <Grid Grid.Row="2" Margin="0,23,0,0" Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SourcesBox" Grid.Column="0" Style="{DynamicResource Select.Field}"
                                      Width="152" SelectionChanged="Sources_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="CatalogStatusBox" Grid.Column="1" Style="{DynamicResource Select.Field}"
                                      Width="134" Margin="11,0,0,0" SelectedIndex="0"
                                      SelectionChanged="CatalogStatus_Changed">
                                <ComboBoxItem Content="全部状态" />
                                <ComboBoxItem Content="可播放" />
                                <ComboBoxItem Content="待播放" />
                                <ComboBoxItem Content="不可访问" />
                            </ComboBox>
                            <TextBlock Grid.Column="3" Style="{DynamicResource Text.Faint}" Text="Ctrl / Shift 多选"
                                       VerticalAlignment="Center" Margin="0,0,20,0" />
                            <Button Grid.Column="4" Style="{DynamicResource Btn.Link}" Click="RemoveSource_Click"
                                    VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="移除所选来源" />
                            </Button>
                            <Button Grid.Column="5" Style="{DynamicResource Btn.Ghost}" Height="35" Width="165"
                                    Click="EnqueueAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus12}"
                                          Stroke="{DynamicResource Ink900}" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="全部加入队列" Margin="11,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 片库列表 -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="213" />
                                    <ColumnDefinition Width="67" />
                                    <ColumnDefinition Width="117" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{DynamicResource Check.Box}" IsHitTestVisible="False"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{DynamicResource Text.TableHeader}" Text="#"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{DynamicResource Text.TableHeader}" Text="视频 / 分 P"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="3" Style="{DynamicResource Text.TableHeader}" Text="UP 主"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Style="{DynamicResource Text.TableHeader}" Text="分 P"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Style="{DynamicResource Text.TableHeader}" Text="时长"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Style="{DynamicResource Text.TableHeader}" Text="状态"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource Divider}" />
                            <ListBox x:Name="CatalogGrid" Grid.Row="2" Style="{DynamicResource List.Rows}"
                                     SelectionChanged="Catalog_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="57">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="213" />
                                                <ColumnDefinition Width="67" />
                                                <ColumnDefinition Width="117" />
                                                <ColumnDefinition Width="116" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{DynamicResource Check.Box}"
                                                      IsHitTestVisible="False" IsChecked="{Binding IsSelected,
                                                      RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <Grid Grid.Column="1">
                                                <Border x:Name="RowChip" Style="{DynamicResource Chip.Playing}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                    <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.Note}"
                                                          Stroke="{DynamicResource OnInk}" Width="12" Height="14"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="RowIndex" Text="{Binding Index}"
                                                           Style="{DynamicResource Text.Faint}" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Margin="4,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Entry.Title}" Style="{DynamicResource Text.RowTitle}" />
                                                <TextBlock Text="{Binding Source}" Style="{DynamicResource Text.Faint}"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Entry.Uploader}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink700}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding Entry.Page}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Duration}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="RowInfoMark" Style="{DynamicResource Icon}"
                                                      Data="{DynamicResource Icon.Info}" Stroke="{DynamicResource Ink500}"
                                                      Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                                <TextBlock Text="{Binding Status}" Style="{DynamicResource Text.Meta}"
                                                           Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="7" Style="{DynamicResource Btn.Icon}" Width="24" Height="24"
                                                    Click="Enqueue_Click" ToolTip="加入播放队列">
                                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus12}"
                                                      Stroke="{DynamicResource Ink500}" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Playing}" Value="True">
                                                <Setter TargetName="RowChip" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RowIndex" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Unavailable}" Value="True">
                                                <Setter TargetName="RowInfoMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 多选操作条 -->
                        <Grid x:Name="SelectionBar" Grid.Row="4" Height="35" Margin="0,12,0,12" Visibility="Collapsed">
                            <Border Background="{DynamicResource Surface2}" />
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionCountText" Style="{DynamicResource Text.Quiet}"
                                           Foreground="{DynamicResource Ink700}" Text="已选择 0 项" VerticalAlignment="Center" />
                                <Border Width="1" Height="16" Background="{DynamicResource LineField}" Margin="18,0,18,0" />
                                <Button Style="{DynamicResource Btn.Link}" Click="EntryUp_Click" Margin="0,0,28,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.ArrowUp}"
                                              Stroke="{DynamicResource Ink500}" Width="8" Height="11" VerticalAlignment="Center" />
                                        <TextBlock Text="上移" Style="{DynamicResource Text.Faint}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource Btn.Link}" Click="EntryDown_Click" Margin="0,0,28,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.ArrowDown}"
                                              Stroke="{DynamicResource Ink500}" Width="8" Height="11" VerticalAlignment="Center" />
                                        <TextBlock Text="下移" Style="{DynamicResource Text.Faint}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource Btn.Link}" Click="DeleteEntry_Click">
                                    <TextBlock Text="删除" Style="{DynamicResource Text.Meta}"
                                               Foreground="{DynamicResource Ink700}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{DynamicResource Btn.Link}" Click="UnselectAll_Click" Margin="0,0,30,0">
                                    <TextBlock Text="取消选择" Style="{DynamicResource Text.Faint}" />
                                </Button>
                                <Button Style="{DynamicResource Btn.Primary}" Height="35" Click="Enqueue_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus11}"
                                              Stroke="{DynamicResource OnInk}" StrokeThickness="1.07"
                                              Width="11" Height="11" VerticalAlignment="Center" />
                                        <TextBlock Text="加入播放队列" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ================= 三 · 播放队列 ================= -->
                <TabItem Style="{DynamicResource Page.Plain}">
                    <Grid x:Name="QueuePanel" Margin="44,36,44,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,26">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="播放队列" />
                                <TextBlock x:Name="QueueTitle" Style="{DynamicResource Text.PageSubtitle}"
                                           Text="共 0 项 · 双击条目切换播放，队列顺序会自动保存。" Margin="0,11,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Style="{DynamicResource Btn.Primary}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="PlaySelected_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Play}"
                                          Fill="{DynamicResource OnInk}" StrokeThickness="0"
                                          Width="8" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="播放所选" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModeBox" Grid.Column="0" Style="{DynamicResource Select.Field}"
                                      Width="159" SelectionChanged="Mode_Changed">
                                <ComboBoxItem Content="列表循环" />
                                <ComboBoxItem Content="顺序播放" />
                            </ComboBox>
                            <TextBlock Grid.Column="1" Style="{DynamicResource Text.Faint}"
                                       Text="播放到末尾后，从第一项继续。" Margin="22,0,0,0" VerticalAlignment="Center" />
                            <Button x:Name="QueueUpButton" Grid.Column="2" Style="{DynamicResource Btn.Ghost}"
                                    Height="35" Width="81" Click="QueueUp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.ArrowUp}"
                                          Stroke="{DynamicResource Ink900}" Width="8" Height="11" VerticalAlignment="Center" />
                                    <TextBlock Text="上移" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="QueueDownButton" Grid.Column="3" Style="{DynamicResource Btn.Ghost}"
                                    Height="35" Width="81" Margin="11,0,0,0" Click="QueueDown_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.ArrowDown}"
                                          Stroke="{DynamicResource Ink900}" Width="8" Height="11" VerticalAlignment="Center" />
                                    <TextBlock Text="下移" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveQueueButton" Grid.Column="4" Style="{DynamicResource Btn.Ghost}"
                                    Height="35" Width="85" Margin="11,0,0,0" Click="RemoveQueue_Click">
                                <TextBlock Text="移除" />
                            </Button>
                        </Grid>

                        <!-- 正在播放 -->
                        <Grid x:Name="QueueNowCard" Grid.Row="2" Height="68" Margin="0,31,0,0"
                              Background="{DynamicResource Surface2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="49" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="1" Source="{DynamicResource Illus.QueueThumb}" Width="49" Height="42"
                                   VerticalAlignment="Center" Stretch="Fill" />
                            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Text.BrandSub}" Text="正在播放"
                                           Foreground="{DynamicResource Ink500}" />
                                <TextBlock x:Name="QueueNowTitleText" Style="{DynamicResource Text.RowTitleLarge}"
                                           Text="" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="QueueNowTimeText" Grid.Column="3" Style="{DynamicResource Text.Quiet}"
                                       Foreground="{DynamicResource Ink700}" VerticalAlignment="Center"
                                       Margin="0,0,20,0" />
                        </Grid>

                        <!-- 队列列表 -->
                        <Grid Grid.Row="3" Margin="0,30,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="133" />
                                    <ColumnDefinition Width="102" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{DynamicResource Text.TableHeader}" Text="顺序"
                                           VerticalAlignment="Center" Margin="18,0,0,0" />
                                <TextBlock Grid.Column="1" Style="{DynamicResource Text.TableHeader}" Text="标题"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{DynamicResource Text.TableHeader}" Text="来源"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Style="{DynamicResource Text.TableHeader}" Text="时长"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Style="{DynamicResource Text.TableHeader}" Text="状态"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource Divider}" />
                            <ListBox x:Name="QueueGrid" Grid.Row="2" Style="{DynamicResource List.Queue}"
                                     MouseDoubleClick="Queue_DoubleClick" SelectionChanged="Queue_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="65">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="320" />
                                                <ColumnDefinition Width="133" />
                                                <ColumnDefinition Width="102" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="RowWash" Grid.ColumnSpan="6"
                                                    Background="{DynamicResource Surface2}" Visibility="Collapsed"
                                                    IsHitTestVisible="False" />
                                            <Border x:Name="RowPlayBar" Style="{DynamicResource Bar.Playing}"
                                                    HorizontalAlignment="Left" Height="25" VerticalAlignment="Center"
                                                    Visibility="Collapsed" />
                                            <Grid Grid.Column="0" Margin="18,0,0,0">
                                                <Border x:Name="RowChip" Style="{DynamicResource Chip.Playing}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                    <Path Style="{DynamicResource Icon.Thin}" Data="{DynamicResource Icon.Note}"
                                                          Stroke="{DynamicResource OnInk}" Width="12" Height="14"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="RowIndex" Text="{Binding Index}"
                                                           Style="{DynamicResource Text.Quiet}"
                                                           Foreground="{DynamicResource Ink400}" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="RowTitleText" Text="{Binding Title}"
                                                           Style="{DynamicResource Text.RowTitleLarge}" />
                                                <TextBlock Text="{Binding Uploader}" Style="{DynamicResource Text.Faint}"
                                                           Margin="0,7,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink700}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Status}"
                                                       Style="{DynamicResource Text.Faint}" VerticalAlignment="Center" />
                                            <Button Grid.Column="5" Style="{DynamicResource Btn.Icon}" Width="22" Height="22"
                                                    Click="RemoveQueue_Click" ToolTip="移除">
                                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.More}"
                                                      Fill="{DynamicResource Ink500}" StrokeThickness="0"
                                                      Width="13" Height="3" />
                                            </Button>
                                            <Border Grid.ColumnSpan="6" Style="{DynamicResource Divider}"
                                                    VerticalAlignment="Bottom" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Playing}" Value="True">
                                                <Setter TargetName="RowWash" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RowPlayBar" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RowChip" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RowIndex" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="RowTitleText" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,17,0,14">
                            <TextBlock Style="{DynamicResource Text.Faint}"
                                       Text="移除条目只影响播放队列，片库中的视频会保留。" />
                            <Button Style="{DynamicResource Btn.Link}" Tag="1" Click="Nav_Click"
                                    HorizontalAlignment="Right">
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="返回片库添加 →" />
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ================= 四 · 订阅漫游 ================= -->
                <TabItem Style="{DynamicResource Page.Plain}">
                    <Grid x:Name="RoamingPanel" Margin="44,36,44,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,26">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="订阅漫游" />
                                <TextBlock x:Name="RoamingSummaryText" Style="{DynamicResource Text.PageSubtitle}"
                                           Text="登录后，选择喜欢的 UP 主即可直接播放"
                                           Margin="0,11,420,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="RoamingManageButton" Style="{DynamicResource Btn.Ghost}"
                                        Content="管理订阅" Click="ManageSubscriptions_Click" Margin="0,0,11,0" />
                                <Button x:Name="RoamingRefreshButton" Style="{DynamicResource Btn.Ghost}"
                                        Content="刷新订阅" Click="RefreshRoaming_Click" Margin="0,0,11,0" />
                                <Button x:Name="RoamingStartButton" Style="{DynamicResource Btn.Primary}"
                                        Content="开始漫游" Click="StartRoaming_Click" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="RoamingPauseButton" Style="{DynamicResource Btn.Ghost}" Height="35"
                                    Content="暂停" Click="Pause_Click" Margin="0,0,11,0" />
                            <Button x:Name="RoamingStopButton" Style="{DynamicResource Btn.Ghost}" Height="35"
                                    Content="停止" Click="Stop_Click" Margin="0,0,11,0" />
                            <Button x:Name="RoamingNextButton" Style="{DynamicResource Btn.Ghost}" Height="35"
                                    Content="下一个" Click="Next_Click" Margin="0,0,11,0" />
                            <Button Style="{DynamicResource Btn.Ghost}" Height="35" Content="取消本次"
                                    Click="CancelRoaming_Click" />
                            <TextBlock x:Name="RoamingStatusText" Style="{DynamicResource Text.Faint}" Margin="22,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                        </StackPanel>

                        <!-- 到点切入提示 -->
                        <Border x:Name="RoamingPendingPanel" Grid.Row="2" Visibility="Collapsed"
                                Background="{DynamicResource Surface2}" Padding="18,14" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink700}"
                                           Text="定时漫游到点：当前视频连续安排的分 P 播完后切入漫游。"
                                           VerticalAlignment="Center" Margin="0,0,320,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource Btn.Ghost}" Height="32" Content="立即开始"
                                            Click="StartRoaming_Click" Margin="0,0,11,0" />
                                    <Button Style="{DynamicResource Btn.Ghost}" Height="32" Content="取消本次"
                                            Click="CancelRoaming_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Height="37" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="RoamingScheduleBox" Style="{DynamicResource Check.Switch}" Width="32"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="每天自动开播" Style="{DynamicResource Text.Body}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="RoamingScheduleInput" Style="{DynamicResource Input.Field}" Width="96"
                                         Height="37" Margin="22,0,0,0" VerticalAlignment="Center" Tag="09:00" />
                                <Button x:Name="RoamingScheduleSaveButton" Style="{DynamicResource Btn.Ghost}"
                                        Height="37" Content="保存计划" Click="SaveRoamingSchedule_Click"
                                        Margin="11,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RoamingNextScheduleText" Style="{DynamicResource Text.Faint}"
                                           Margin="22,0,0,0" VerticalAlignment="Center" Text="未开启自动开播" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="4" Style="{DynamicResource Divider}" Margin="0,0,0,24" />

                        <!-- 已记录内容 -->
                        <Grid Grid.Row="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{DynamicResource Text.TableHeader}" Text="标题" />
                                <TextBlock Grid.Column="1" Style="{DynamicResource Text.TableHeader}" Text="UP 主" />
                                <TextBlock Grid.Column="2" Style="{DynamicResource Text.TableHeader}" Text="发布时间" />
                                <TextBlock Grid.Column="3" Style="{DynamicResource Text.TableHeader}" Text="状态" />
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource Divider}" />
                            <ListBox x:Name="RoamingGrid" Grid.Row="2" Style="{DynamicResource List.Rows}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="57">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                       Style="{DynamicResource Text.RowTitle}" VerticalAlignment="Center"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Uploader}"
                                                       Style="{DynamicResource Text.Quiet}"
                                                       Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Published}"
                                                       Style="{DynamicResource Text.Faint}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                       Style="{DynamicResource Text.Meta}"
                                                       Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ================= 五 · 桌面与后台 ================= -->
                <TabItem Style="{DynamicResource Page.Plain}">
                    <Grid x:Name="DesktopPanel" Margin="44,36,44,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="642" />
                            <ColumnDefinition Width="57" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,31">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="桌面与后台" />
                                <TextBlock Style="{DynamicResource Text.PageSubtitle}"
                                           Text="声音和画面，按你的使用习惯分别设置。" Margin="0,11,0,0" />
                            </StackPanel>
                            <Button Style="{DynamicResource Btn.Primary}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="ApplyDesktop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.CheckSmall}"
                                          Stroke="{DynamicResource OnInk}" StrokeThickness="1.07"
                                          Width="11" Height="8" VerticalAlignment="Center" />
                                    <TextBlock Text="应用设置" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 桌面预览 -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Grid Height="20">
                                <TextBlock Style="{DynamicResource Text.Section}" Text="桌面预览" />
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="显示效果示意" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,0,0" />
                            </Grid>
                            <Border Margin="0,31,0,0" BorderBrush="{DynamicResource LineField}" BorderThickness="1"
                                    ClipToBounds="True" Height="362" Width="642" Background="{DynamicResource Surface3}">
                                <Image Source="{DynamicResource Illus.DesktopPreview}" Width="642" Height="383"
                                       Stretch="Fill" VerticalAlignment="Top" />
                            </Border>
                            <TextBlock x:Name="DesktopPreviewInfoText" Style="{DynamicResource Text.Quiet}"
                                       Foreground="{DynamicResource Ink500}" Text="主显示器 · —" Margin="0,31,0,0" />
                            <TextBlock Style="{DynamicResource Text.Label}" Text="画面适配" Margin="0,30,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="25,25,0,0">
                                <RadioButton x:Name="FitFillRadio" Style="{DynamicResource Radio.Circle}"
                                             Content="填充（裁切）" GroupName="FitMode" IsChecked="True" />
                                <RadioButton x:Name="FitLetterRadio" Style="{DynamicResource Radio.Circle}"
                                             Content="适应（留边）" GroupName="FitMode" Margin="157,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="1,34,0,0">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource Ink500}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DesktopStatus" Style="{DynamicResource Text.Faint}" Margin="13,0,0,0"
                                           Text="正在检查桌面画面状态。" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 桌面画面 / 画质 / 播放器 -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <Grid Height="20">
                                <TextBlock Style="{DynamicResource Text.Section}" Text="桌面画面" />
                                <CheckBox x:Name="WallpaperSwitchMirror" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Width="32"
                                          IsChecked="{Binding IsChecked, ElementName=WallpaperBox, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                       Text="在所选显示器上显示正在播放的视频。" Margin="0,15,0,0" />
                            <TextBlock Style="{DynamicResource Text.Label}" Text="目标显示器" Margin="0,29,0,0" />
                            <ComboBox x:Name="DisplayBox" Style="{DynamicResource Select.Field}" Height="41"
                                      Margin="0,15,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="当前版本一次使用一块屏幕。"
                                       Margin="0,12,0,0" />
                            <Grid Margin="0,28,0,0" Height="20">
                                <CheckBox x:Name="ContinueAudioSwitchMirror" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Stretch" Content="隐藏画面时继续音乐"
                                          IsChecked="{Binding IsChecked, ElementName=ContinueAudioBox, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="关闭画面时，继续播放当前队列。"
                                       Margin="0,8,0,0" />
                            <Border Style="{DynamicResource Divider}" Margin="0,33,0,0" />

                            <Grid Margin="0,26,0,0" Height="20">
                                <CheckBox x:Name="StartupSwitchMirror" Style="{DynamicResource Check.Switch}"
                                          HorizontalAlignment="Stretch" Content="登录后在托盘启动"
                                          IsChecked="{Binding IsChecked, ElementName=StartupBox, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="开启后，下次登录恢复上次的播放进度。"
                                       Margin="0,8,0,0" />
                            <Border Style="{DynamicResource Divider}" Margin="0,33,0,0" />

                            <TextBlock Style="{DynamicResource Text.Section}" Text="播放画质" Margin="0,26,0,0" />
                            <TextBlock Style="{DynamicResource Text.Label}" Text="视频画质" Margin="0,20,0,0" />
                            <ComboBox x:Name="VideoQualityBox" Style="{DynamicResource Select.Field}" Height="41"
                                      Margin="0,11,0,0" SelectionChanged="VideoQuality_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="音质" Margin="0,18,0,0" />
                            <ComboBox x:Name="AudioQualityBox" Style="{DynamicResource Select.Field}" Height="41"
                                      Margin="0,11,0,0" SelectionChanged="AudioQuality_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="QualityStatusText" Style="{DynamicResource Text.Faint}" Text=""
                                       Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Style="{DynamicResource Divider}" Margin="0,33,0,0" />

                            <TextBlock Style="{DynamicResource Text.Section}" Text="播放器" Margin="0,26,0,0" />
                            <TextBlock Style="{DynamicResource Text.Label}" Text="mpv 路径" Margin="0,20,0,0" />
                            <TextBox x:Name="MpvPathInput" Style="{DynamicResource Input.Plain}" Margin="0,11,0,0"
                                     Tag="mpv" />
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="修改后，下次加载视频时生效。"
                                       Margin="0,12,0,0" />
                            <Border Style="{DynamicResource Divider}" Margin="0,33,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="3,24,0,0">
                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.NavTray}"
                                      Stroke="{DynamicResource Ink500}" Width="13" Height="14" VerticalAlignment="Center" />
                                <TextBlock Style="{DynamicResource Text.Faint}" Text="关闭窗口收起到托盘，音乐继续播放。"
                                           Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ==================================================================
             底部播放条
             ================================================================== -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface0}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- 封面与标题 -->
                <StackPanel x:Name="PlayerPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="44,0,0,0" Width="356">
                    <Image Source="{DynamicResource Illus.PlayerThumb}" Width="49" Height="45" Stretch="Fill" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Width="291">
                        <TextBlock x:Name="CurrentText" Style="{DynamicResource Text.RowTitleLarge}" Text="尚未选择播放项"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlaybackSourceText" Style="{DynamicResource Text.Faint}" Text="手动播放"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 传输控制 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="391,0,0,0">
                    <Button Style="{DynamicResource Btn.Icon}" Click="Previous_Click" ToolTip="上一个">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Prev}"
                              Fill="{DynamicResource Ink900}" Stroke="{DynamicResource Ink900}"
                              Width="11" Height="13" />
                    </Button>
                    <Button Style="{DynamicResource Btn.Icon}" Width="36" Height="36" Margin="15,0,0,0"
                            Click="Media_Click" ToolTip="播放 / 暂停">
                        <Grid>
                            <Path Data="{DynamicResource Icon.Disc}" Fill="{DynamicResource SurfaceInk}"
                                  Width="36" Height="36" />
                            <Path Data="{DynamicResource Icon.Pause}" Fill="{DynamicResource OnInk}"
                                  Width="9" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{DynamicResource Btn.Icon}" Click="Next_Click" ToolTip="下一个" Margin="23,0,0,0">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Next}"
                              Fill="{DynamicResource Ink900}" Stroke="{DynamicResource Ink900}"
                              Width="11" Height="13" />
                    </Button>
                    <Button Style="{DynamicResource Btn.Icon}" Click="Stop_Click" ToolTip="停止" Margin="22,0,0,0">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Stop}"
                              Stroke="{DynamicResource Ink700}" Width="10" Height="10" />
                    </Button>
                    <Button Style="{DynamicResource Btn.Icon}" Click="Reload_Click" ToolTip="重新加载当前地址"
                            Margin="22,0,0,0">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Repeat}"
                              Stroke="{DynamicResource Ink700}" Width="12" Height="14" />
                    </Button>
                </StackPanel>

                <!-- 进度 -->
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="655,0,0,0" Width="230">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="BarPositionText" Style="{DynamicResource Text.Faint}"
                                   Foreground="{DynamicResource Ink700}" Text="00:00" />
                        <TextBlock x:Name="BarDurationText" Style="{DynamicResource Text.Faint}" Text="00:00"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="BarProgress" Grid.Row="1" Style="{DynamicResource Slider.Flat}" Maximum="1"
                            Value="0" Margin="0,9,0,0" />
                </Grid>

                <!-- 音量 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="943,0,0,0">
                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Volume}"
                          Stroke="{DynamicResource Ink700}" Width="17" Height="12" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Style="{DynamicResource Slider.Flat}" Width="94" Minimum="0"
                            Maximum="1" Margin="15,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarVolumeText" Style="{DynamicResource Text.Faint}" Text="0" Margin="18,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右端：桌面画面与队列 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,32,0">
                    <Button Style="{DynamicResource Btn.Icon}" Click="ToggleWallpaper_Click"
                            ToolTip="显示 / 隐藏桌面画面" Margin="0,0,18,0">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Monitor}"
                              Stroke="{DynamicResource Ink700}" Width="15" Height="14" />
                    </Button>
                    <Button Style="{DynamicResource Btn.Icon}" Tag="2" Click="Nav_Click" ToolTip="播放队列">
                        <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.QueueBadge}"
                              Stroke="{DynamicResource Ink700}" Width="14" Height="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================================
             添加来源弹窗（覆盖层，规格见设计稿画板 04）
             ================================================================== -->
        <Grid x:Name="AddSourceOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource Scrim}" Opacity="0.88" />
            <Border x:Name="ImportPanel" Width="640" Height="630" Background="{DynamicResource Surface0}"
                    BorderBrush="{DynamicResource LineField}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="32,27,32,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{DynamicResource Text.PageTitle}" FontSize="23" Text="添加来源" />
                        <Button Style="{DynamicResource Btn.Icon}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseImport_Click" ToolTip="关闭">
                            <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Close}"
                                  Stroke="{DynamicResource Ink700}" Width="11" Height="11" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{DynamicResource Text.Muted}" Text="从喜欢的视频或合集开始。"
                               Margin="0,17,0,0" />

                    <!-- 导入方式 -->
                    <Grid Grid.Row="2" Margin="0,35,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ImportTabsPanel" Orientation="Horizontal" Height="22">
                            <Button Style="{DynamicResource Btn.Link}" Click="ImportTabVideo_Click">
                                <TextBlock x:Name="ImportTabVideoText" Style="{DynamicResource Text.RowTitle}"
                                           FontSize="12" Text="视频 / BV" />
                            </Button>
                            <Button Style="{DynamicResource Btn.Link}" Click="ImportTabCollection_Click"
                                    Margin="84,0,0,0">
                                <TextBlock x:Name="ImportTabCollectionText" Style="{DynamicResource Text.RowTitle}"
                                           FontSize="12" FontWeight="Bold" Text="合集 / 系列" />
                            </Button>
                            <Button Style="{DynamicResource Btn.Link}" Click="ImportTabIds_Click" Margin="84,0,0,0">
                                <TextBlock x:Name="ImportTabIdsText" Style="{DynamicResource Text.RowTitle}"
                                           FontSize="12" Text="按 ID 导入" />
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Border x:Name="ImportTabUnderline" Background="{DynamicResource SurfaceInk}"
                                    Height="2" HorizontalAlignment="Left" Margin="0,0,0,0" Width="80" />
                            <Border Style="{DynamicResource Divider}" />
                        </Grid>
                    </Grid>

                    <!-- 三种方式各自的表单 -->
                    <Grid Grid.Row="3" Margin="0,37,0,0">
                        <StackPanel x:Name="ImportVideoPanel" Visibility="Collapsed">
                            <TextBlock Style="{DynamicResource Text.LabelStrong}" Text="视频链接或 BV 号" />
                            <TextBox x:Name="VideoInput" Style="{DynamicResource Input.Dialog}" Margin="0,16,0,0"
                                     Tag="粘贴视频链接或 BV 号" />
                            <TextBlock Style="{DynamicResource Text.Faint}" Text="支持 bilibili.com 视频链接与 BV 号。"
                                       Margin="0,17,0,0" />
                            <TextBlock Style="{DynamicResource Text.StateTitle}" FontSize="14"
                                       Text="将自动读取全部分 P" Margin="0,40,0,0" />
                            <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                       Text="重复内容会合并到片库，现有队列与进度会保留。" Margin="0,17,0,0" />
                            <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                       Text="导入后，可选择需要的条目加入播放队列。" Margin="0,11,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="ImportCollectionPanel">
                            <TextBlock Style="{DynamicResource Text.LabelStrong}" Text="合集或系列链接" />
                            <Grid Margin="0,16,0,0">
                                <TextBox x:Name="CollectionInput" Style="{DynamicResource Input.Dialog}"
                                         Padding="35,0,11,0" Tag="粘贴 B 站合集或系列链接" />
                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Link}"
                                      Stroke="{DynamicResource Ink500}" Width="13" Height="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Text.Faint}"
                                       Text="支持 space.bilibili.com 下的合集、系列及旧版列表链接。" Margin="0,17,0,0" />
                            <TextBlock Style="{DynamicResource Text.StateTitle}" FontSize="14"
                                       Text="将自动读取全部分 P" Margin="0,40,0,0" />
                            <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                       Text="重复内容会合并到片库，现有队列与进度会保留。" Margin="0,17,0,0" />
                            <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                       Text="导入后，可选择需要的条目加入播放队列。" Margin="0,11,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="1,36,0,0">
                                <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Info}"
                                      Stroke="{DynamicResource Ink500}" Width="11" Height="11"
                                      VerticalAlignment="Center" />
                                <TextBlock Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                                           Text="仅支持可匿名访问的公开视频。" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ImportIdsPanel" Visibility="Collapsed">
                            <TextBlock Style="{DynamicResource Text.LabelStrong}" Text="UP 主 ID" />
                            <TextBox x:Name="UploaderInput" Style="{DynamicResource Input.Dialog}" Margin="0,16,0,0"
                                     Tag="例如 12345678" />
                            <TextBlock Style="{DynamicResource Text.LabelStrong}" Text="合集 ID" Margin="0,26,0,0" />
                            <TextBox x:Name="CollectionIdInput" Style="{DynamicResource Input.Dialog}" Margin="0,16,0,0"
                                     Tag="例如 123456" />
                            <TextBlock Style="{DynamicResource Text.LabelStrong}" Text="类型" Margin="0,26,0,0" />
                            <ComboBox x:Name="KindBox" Style="{DynamicResource Select.Field}" Height="45" Margin="0,16,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="合集（season）" />
                                <ComboBoxItem Content="系列（series）" />
                            </ComboBox>
                            <TextBlock Style="{DynamicResource Text.Faint}"
                                       Text="按 ID 导入只读取合集本身，不含 UP 主的其他投稿。" Margin="0,17,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <TextBlock Style="{DynamicResource Text.Faint}" Text="导入不影响当前播放" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource Btn.Ghost}" Width="84" Content="取消" Click="CloseImport_Click" />
                            <Button Style="{DynamicResource Btn.Primary}" Width="131" Margin="11,0,0,0"
                                    Click="ImportPrimary_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource Icon}" Data="{DynamicResource Icon.Plus11}"
                                          Stroke="{DynamicResource OnInk}" StrokeThickness="1.07"
                                          Width="11" Height="11" VerticalAlignment="Center" />
                                    <TextBlock Text="导入" Foreground="{DynamicResource OnInk}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
