<Window x:Class="WallBili.Desktop.LoginDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="登录 B 站账号" Style="{StaticResource {x:Type Window}}" Width="600" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded" Closing="Window_Closing" xmlns:ui="clr-namespace:WallBili.Desktop.Presentation" WindowStyle="None" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#808080" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabLine" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,24,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabLine" Property="BorderBrush" Value="#191919" />
                                <Setter Property="Foreground" Value="#191919" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#DADADA" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="White" MouseLeftButtonDown="Caption_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,46,0">
                    <ui:LineIcon Kind="Sound" Width="16" Height="16" Margin="0,0,9,0" />
                    <TextBlock Text="WallBili · 登录" FontSize="12" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="34" Height="30" HorizontalAlignment="Right" Click="Caption_Close" ToolTip="关闭">
                    <ui:LineIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
            <Grid Margin="32,18,32,24" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="登录 B 站账号" FontSize="24" FontWeight="Medium" FontFamily="{x:Static ui:UiTypography.StrongFamily}" />
                    <TextBlock Text="使用账号可获取当前账号支持的画质与音质。" Foreground="#808080" FontSize="13" Margin="0,12,0,0" />
                </StackPanel>
                <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_Changed" BorderThickness="0" Background="White">
                    <TabItem Header="扫码登录">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Image x:Name="QrImage" Width="192" Height="192" Stretch="Uniform" />
                            <TextBlock x:Name="QrStatus" Text="正在获取二维码…" FontSize="13" Margin="0,20,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                            <Button Content="重新获取二维码" Click="RefreshQr_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="导入 Cookie">
                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="Cookie 文本" FontSize="13" />
                            <TextBox x:Name="CookieInput" Margin="0,12,0,16" MinHeight="90" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="B 站 Cookie" />
                            <TextBlock Text="至少包含 SESSDATA。账号信息仅在本机加密保存。" FontSize="12" Foreground="#808080" TextWrapping="Wrap" />
                            <Button Content="验证并导入" Click="Import_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,12" />
                            <TextBlock x:Name="ImportStatus" Foreground="#555555" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="2" Text="退出登录后，已导入的片库和播放队列仍会保留。" FontSize="12" Foreground="#999999" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</Window>
