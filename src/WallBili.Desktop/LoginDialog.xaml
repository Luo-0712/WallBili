<Window x:Class="WallBili.Desktop.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 B 站账号" Width="440" Height="540" MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <!-- 视觉沿用 2_2 设计稿的令牌：严格灰阶、直角、下划线页签。 -->
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock Style="{DynamicResource Text.PageTitle}" FontSize="23" Text="登录 B 站账号" />
            <TextBlock Style="{DynamicResource Text.Muted}" Margin="0,11,0,0"
                       Text="登录后可选择动态画质并订阅 UP 主，凭据仅保存在本机。" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Style="{DynamicResource Tabs.Underline}"
                    SelectionChanged="Tabs_Changed">
            <TabItem Header="扫码登录" Style="{DynamicResource Tab.Underline}">
                <Grid Margin="0,26,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="QrStatus" Grid.Row="0" Style="{DynamicResource Text.Body}"
                               Text="正在获取二维码…" />
                    <Border Grid.Row="1" Background="{DynamicResource Surface2}" Padding="10"
                            HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Image x:Name="QrImage" Width="230" Height="230" />
                    </Border>
                    <Button Grid.Row="2" Style="{DynamicResource Btn.Ghost}" Content="重新获取二维码"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Click="RefreshQr_Click" />
                    <TextBlock Grid.Row="3" Style="{DynamicResource Text.Quiet}" Foreground="{DynamicResource Ink500}"
                               Text="请使用 B 站手机客户端扫码，并在手机上确认登录。二维码 3 分钟内有效。"
                               Margin="0,20,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="导入 Cookie" Style="{DynamicResource Tab.Underline}">
                <Grid Margin="0,26,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource Text.Body}"
                               Text="粘贴浏览器中的 Cookie 文本（name=value; …），至少包含 SESSDATA。" />
                    <TextBox x:Name="CookieInput" Grid.Row="1" Style="{DynamicResource Input.Area}" Height="140"
                             Margin="0,16,0,0" Tag="SESSDATA=…"
                             ToolTip="可从浏览器开发者工具的请求头中复制 Cookie 字段" />
                    <Button Grid.Row="2" Style="{DynamicResource Btn.Primary}" Content="导入并验证"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Click="Import_Click" />
                    <TextBlock x:Name="ImportStatus" Grid.Row="3" Style="{DynamicResource Text.Quiet}"
                               Foreground="{DynamicResource Ink500}" Margin="0,18,0,0" />
                    <TextBlock Grid.Row="4" Style="{DynamicResource Text.Faint}"
                               Text="导入仅用于 WallBili 内的播放请求；退出登录不会使浏览器或其他设备登出。"
                               Margin="0,18,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
