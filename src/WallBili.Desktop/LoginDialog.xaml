<Window x:Class="WallBili.Desktop.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 B 站账号" Width="440" Height="520" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <TabControl x:Name="Tabs" Margin="16" SelectionChanged="Tabs_Changed">
        <TabItem Header="扫码登录">
            <StackPanel Margin="12,16,12,12">
                <TextBlock x:Name="QrStatus" Text="正在获取二维码…" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Image x:Name="QrImage" Width="230" Height="230" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <Button Content="重新获取二维码" HorizontalAlignment="Center" Click="RefreshQr_Click"/>
                <TextBlock Text="请使用 B 站手机客户端扫码，并在手机上确认登录。二维码 3 分钟内有效。"
                           Foreground="#536170" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="导入 Cookie">
            <StackPanel Margin="12,16,12,12">
                <TextBlock Text="粘贴浏览器中的 Cookie 文本（name=value; …），至少包含 SESSDATA。"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="CookieInput" Height="140" AcceptsReturn="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,8"
                         ToolTip="可从浏览器开发者工具的请求头中复制 Cookie 字段"/>
                <Button Content="导入并验证" HorizontalAlignment="Left" Click="Import_Click"/>
                <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#536170"/>
                <TextBlock Text="导入仅用于 WallBili 内的播放请求；退出登录不会使浏览器或其他设备登出。"
                           Foreground="#536170" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
